
@{
    ViewBag.Title = "İletisim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="page-section" id="contact">
    <div class="container">
        <div class="text-center">
            <h2 class="section-heading text-uppercase">BİZİMLE İLETİŞİME GEÇ</h2>
            <h3 class="section-subheading text-muted">Etkinliklerimize katılmak ve topluluğumuzun bir parçası olmak için iletişime geçerek kolayca üye kaydı oluşturabilirsiniz</h3>
        </div>

        <!-- Form Açma Butonları -->
        <div class="text-center">
            <button type="button"
                    class="btn btn-primary btn-xl text-uppercase me-3 mb-3"
                    data-bs-toggle="modal"
                    data-bs-target="#contactModal">
                <i class="fas fa-envelope me-2"></i>
                İletişim Formu
            </button>

            <a href="https://docs.google.com/forms/d/e/1FAIpQLSevQDKfa-JbYrnA5_gwUmDCDqlcPpdTl95UC-9_u1eS_scYCQ/viewform?usp=sf_link"
               class="btn btn-outline-primary btn-xl text-uppercase mb-3"
               target="_blank">
                <i class="fas fa-external-link-alt me-2"></i>
                Formu Yeni Sekmede Aç
            </a>
        </div>

        <!-- İletişim Bilgileri -->
        <div class="row text-center mt-5">
            <div class="col-md-4">
                <div class="team-member">
                    <i class="fas fa-envelope fa-3x text-primary mb-3"></i>
                    <h4>E-posta</h4>
                    <p class="text-muted">sinandogan360@gmail.com</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="team-member">
                    <i class="fas fa-phone fa-3x text-primary mb-3"></i>
                    <h4>Telefon</h4>
                    <p class="text-muted">+90 537 040 80 26</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="team-member">
                    <i class="fas fa-map-marker-alt fa-3x text-primary mb-3"></i>
                    <h4>Adres</h4>
                    <p class="text-muted">Muğla, Türkiye</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="contactModalLabel">
                    <i class="fas fa-envelope me-2"></i>
                    İletişim Formu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-0">
                <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSevQDKfa-JbYrnA5_gwUmDCDqlcPpdTl95UC-9_u1eS_scYCQ/viewform?usp=sf_link"
                        width="100%"
                        height="700"
                        frameborder="0"
                        marginheight="0"
                        marginwidth="0">
                    Form yükleniyor...
                </iframe>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSevQDKfa-JbYrnA5_gwUmDCDqlcPpdTl95UC-9_u1eS_scYCQ/viewform?usp=sf_link"
                   class="btn btn-primary"
                   target="_blank">
                    Yeni Sekmede Aç
                </a>
            </div>
        </div>
    </div>
</div>


